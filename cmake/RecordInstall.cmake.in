# Runs after the project's own install rules, in install scope.
list(LENGTH CMAKE_INSTALL_MANIFEST_FILES _manifest_end)
math(EXPR _manifest_count "${_manifest_end} - ${_@manifest_project@_install_start}")
if(_manifest_count EQUAL 0)
  return()
endif()
list(SUBLIST CMAKE_INSTALL_MANIFEST_FILES ${_@manifest_project@_install_start}
  ${_manifest_count} _manifest_files)
list(REMOVE_DUPLICATES _manifest_files)

# Quote values before passing them through CMake's JSON command.
function(_@manifest_project@_json_quote value result)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${result} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Prefix, staging root, configuration and component identify one install record.
set(_manifest_prefix "${CMAKE_INSTALL_PREFIX}")
cmake_path(NORMAL_PATH _manifest_prefix)
set(_manifest_destdir "$ENV{DESTDIR}")
if(_manifest_destdir)
  cmake_path(IS_ABSOLUTE _manifest_destdir _destdir_absolute)
  if(NOT _destdir_absolute)
    message(FATAL_ERROR "DESTDIR must be absolute for install ownership records")
  endif()
  cmake_path(NORMAL_PATH _manifest_destdir)
endif()
set(_manifest_config "${CMAKE_INSTALL_CONFIG_NAME}")
set(_manifest_component "${CMAKE_INSTALL_COMPONENT}")
set(_manifest_json "{\"version\":1,\"project\":\"@manifest_project@\"}")
foreach(_field prefix destdir config component)
  _@manifest_project@_json_quote("${_manifest_${_field}}" _value)
  string(JSON _manifest_json SET "${_manifest_json}" ${_field} "${_value}")
endforeach()

string(SHA256 _manifest_id "${_manifest_json}")
set(_manifest_path "@manifest_directory@/${_manifest_id}.json")

# Repeated component installs merge paths into the same ownership record.
if(EXISTS "${_manifest_path}")
  file(READ "${_manifest_path}" _old_manifest)
  string(JSON _old_identity REMOVE "${_old_manifest}" files)
  if(NOT _old_identity STREQUAL _manifest_json)
    message(FATAL_ERROR "Install record identity mismatch: ${_manifest_path}")
  endif()
  string(JSON _old_count LENGTH "${_old_manifest}" files)
  if(_old_count GREATER 0)
    math(EXPR _old_last "${_old_count} - 1")
    foreach(_index RANGE ${_old_last})
      string(JSON _old_file GET "${_old_manifest}" files ${_index})
      list(APPEND _manifest_files "${_old_file}")
    endforeach()
  endif()
endif()

list(REMOVE_DUPLICATES _manifest_files)
list(SORT _manifest_files)
string(JSON _manifest_json SET "${_manifest_json}" files "[]")
set(_index 0)
foreach(_file IN LISTS _manifest_files)
  _@manifest_project@_json_quote("${_file}" _value)
  string(JSON _manifest_json SET "${_manifest_json}" files ${_index} "${_value}")
  math(EXPR _index "${_index} + 1")
endforeach()

# Replace the record atomically after its complete JSON value is assembled.
file(MAKE_DIRECTORY "@manifest_directory@")
file(WRITE "${_manifest_path}.tmp" "${_manifest_json}\n")
file(RENAME "${_manifest_path}.tmp" "${_manifest_path}")
