cmake_minimum_required(VERSION 3.24)


set(_project "@manifest_project@")
set(_manifest_directory "@manifest_directory@")
file(GLOB _records "${_manifest_directory}/*.json")
if(NOT _records)
  message(FATAL_ERROR "No ${_project} install records in ${_manifest_directory}")
endif()

# DESTDIR and an optional prefix select the exact installation to remove.
set(_requested_destdir "$ENV{DESTDIR}")
if(_requested_destdir)
  cmake_path(NORMAL_PATH _requested_destdir)
endif()
string(TOUPPER "${_project}" _option_prefix)
set(_requested_prefix "${${_option_prefix}_UNINSTALL_PREFIX}")
if(_requested_prefix)
  cmake_path(NORMAL_PATH _requested_prefix)
endif()
set(_prefixes "")
set(_files "")

# Validate all selected records before removing any file.
foreach(_record IN LISTS _records)
  file(READ "${_record}" _json)
  string(JSON _version GET "${_json}" version)
  string(JSON _owner GET "${_json}" project)
  if(NOT _version EQUAL 1 OR NOT _owner STREQUAL _project)
    message(FATAL_ERROR "Unknown install record: ${_record}")
  endif()
  foreach(_field prefix destdir config component)
    string(JSON _type TYPE "${_json}" ${_field})
    if(NOT _type STREQUAL "STRING")
      message(FATAL_ERROR "Invalid ${_field} in ${_record}")
    endif()
    string(JSON _${_field} GET "${_json}" ${_field})
  endforeach()
  string(JSON _identity REMOVE "${_json}" files)
  string(SHA256 _id "${_identity}")
  get_filename_component(_name "${_record}" NAME_WE)
  if(NOT _name STREQUAL _id)
    message(FATAL_ERROR "Install record identity mismatch: ${_record}")
  endif()
  if(NOT _destdir STREQUAL _requested_destdir)
    continue()
  endif()
  if(_requested_prefix AND NOT _prefix STREQUAL _requested_prefix)
    continue()
  endif()

  # Recorded logical paths must remain strictly below their install prefix.
  cmake_path(IS_ABSOLUTE _prefix _prefix_absolute)
  if(NOT _prefix_absolute OR _prefix MATCHES "[\r\n;]")
    message(FATAL_ERROR "Invalid install prefix in ${_record}")
  endif()
  cmake_path(NORMAL_PATH _prefix)
  list(APPEND _prefixes "${_prefix}")
  string(JSON _files_type TYPE "${_json}" files)
  if(NOT _files_type STREQUAL "ARRAY")
    message(FATAL_ERROR "Invalid installed file list in ${_record}")
  endif()
  string(JSON _count LENGTH "${_json}" files)
  if(_count GREATER 0)
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE ${_last})
      string(JSON _file_type TYPE "${_json}" files ${_index})
      if(NOT _file_type STREQUAL "STRING")
        message(FATAL_ERROR "Invalid installed file entry in ${_record}")
      endif()
      string(JSON _file GET "${_json}" files ${_index})
      cmake_path(IS_ABSOLUTE _file _absolute)
      if(NOT _absolute OR _file MATCHES "[\r\n;]")
        message(FATAL_ERROR "Invalid installed path in ${_record}")
      endif()
      cmake_path(NORMAL_PATH _file)
      cmake_path(IS_PREFIX _prefix "${_file}" NORMALIZE _inside_prefix)
      if(NOT _inside_prefix OR _file STREQUAL _prefix)
        message(FATAL_ERROR "Installed path escapes its recorded prefix: ${_file}")
      endif()

      # Resolve parents to prevent directory links from escaping the prefix.
      set(_physical "${_destdir}${_file}")
      get_filename_component(_physical_parent "${_physical}" DIRECTORY)
      file(REAL_PATH "${_destdir}${_prefix}" _physical_root)
      file(REAL_PATH "${_physical_parent}" _resolved_parent)
      cmake_path(IS_PREFIX _physical_root "${_resolved_parent}" NORMALIZE _inside_root)
      if(NOT _inside_root)
        message(FATAL_ERROR "Installed path crosses a directory link outside its prefix: ${_physical}")
      endif()
      if(IS_DIRECTORY "${_physical}" AND NOT IS_SYMLINK "${_physical}")
        message(FATAL_ERROR "Refusing to remove an installed directory: ${_physical}")
      endif()
      list(APPEND _files "${_physical}")
    endforeach()
  endif()
endforeach()

# Ambiguous prefix selection is rejected before any removal starts.
list(REMOVE_DUPLICATES _prefixes)
list(LENGTH _prefixes _prefix_count)
if(NOT _prefix_count EQUAL 1)
  message(FATAL_ERROR
    "Select one installed prefix with -D${_option_prefix}_UNINSTALL_PREFIX=<prefix>; matches: ${_prefixes}")
endif()

list(REMOVE_DUPLICATES _files)

# Remove files and links only; installed directories remain intact.
foreach(_file IN LISTS _files)
  if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
    file(REMOVE "${_file}")
    if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
      message(FATAL_ERROR "Unable to remove ${_file}")
    endif()
    message(STATUS "Removed ${_file}")
  endif()
endforeach()
