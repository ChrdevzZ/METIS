cmake_minimum_required(VERSION 3.24)

if(NOT FIXTURE_SOURCE OR NOT WORK_DIR OR NOT MODULE_FILE OR NOT PROBE_FUNCTION)
  message(FATAL_ERROR "The standard-cache runner needs fixture, work and helper inputs")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(WORK_DIR "${WORK_DIR}/${run_id}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(command "${CMAKE_COMMAND}" -S "${FIXTURE_SOURCE}" -G "${GENERATOR}")
if(TEST_INITIAL_CACHE)
  list(APPEND command -C "${TEST_INITIAL_CACHE}")
endif()
foreach(field MAKE_PROGRAM C_COMPILER CXX_COMPILER)
  if(DEFINED ${field} AND NOT "${${field}}" STREQUAL "")
    list(APPEND command "-DCMAKE_${field}=${${field}}")
  endif()
endforeach()
foreach(field INSTANCE PLATFORM TOOLSET)
  if(DEFINED GENERATOR_${field} AND NOT "${GENERATOR_${field}}" STREQUAL "")
    list(APPEND command "-DCMAKE_GENERATOR_${field}=${GENERATOR_${field}}")
  endif()
endforeach()
list(APPEND command "-DMODULE_FILE=${MODULE_FILE}" "-DPROBE_FUNCTION=${PROBE_FUNCTION}"
  "-DCMAKE_BUILD_TYPE=${TEST_CONFIG}" "-DCMAKE_TRY_COMPILE_CONFIGURATION=${TEST_CONFIG}")

function(json_string output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(configure label directory mode)
  set(argv ${command} -B "${directory}" "-DPROBE_MODE=${mode}" ${ARGN})
  string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
  execute_process(COMMAND ${argv} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(WRITE "${WORK_DIR}/${label}.stdout.log" "${output}")
  file(WRITE "${WORK_DIR}/${label}.stderr.log" "${error}")
  file(SHA256 "${WORK_DIR}/${label}.stdout.log" stdout_hash)
  file(SHA256 "${WORK_DIR}/${label}.stderr.log" stderr_hash)
  set(items "")
  foreach(arg IN LISTS argv)
    json_string(item "${arg}")
    list(APPEND items "${item}")
  endforeach()
  list(JOIN items "," args_json)
  json_string(cwd "${CMAKE_CURRENT_BINARY_DIR}")
  file(WRITE "${WORK_DIR}/${label}.command.json"
    "{\"argv\":[${args_json}],\"cwd\":${cwd},\"start_utc\":\"${start}\",\"end_utc\":\"${end}\",\"exit\":\"${result}\",\"stdout_sha256\":\"${stdout_hash}\",\"stderr_sha256\":\"${stderr_hash}\",\"environment\":\"inherited unchanged from recorded parent CTest command\"}\n")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Standard-cache configure ${label} failed:\n${output}\n${error}")
  endif()
endfunction()

configure(cycle "${WORK_DIR}/c" cycle)
configure(reconfigure-high-1 "${WORK_DIR}/r" high)
configure(reconfigure-low "${WORK_DIR}/r" low)
configure(reconfigure-high-2 "${WORK_DIR}/r" high)
configure(fresh-low "${WORK_DIR}/lo" low)
configure(preload-old "${WORK_DIR}/pre" high -DPRELOAD_OLD=ON)
configure(preload-new "${WORK_DIR}/pre" high -DPRELOAD_OLD=OFF)
configure(caller-old "${WORK_DIR}/old" high -DCALLER_OLD=ON)
message(STATUS "STANDARD_CACHE_REGRESSION_PASSED: ${PROBE_FUNCTION}")
