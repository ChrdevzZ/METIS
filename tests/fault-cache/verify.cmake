  if(NOT CASE STREQUAL "literal")
    file(MAKE_DIRECTORY "${child}/.cmake/api/v1/query/client-metis-fault-cache")
    file(WRITE "${child}/.cmake/api/v1/query/client-metis-fault-cache/codemodel-v2" "")
  endif()
endif()
set(command "${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}/parent"
  -B "${parent}" -G "${GENERATOR}" -C "${TEST_INITIAL_CACHE}"
  -C "${WORK_DIR}/parent-input.cmake"
  "-DMETIS_SOURCE=${METIS_SOURCE}" "-DCHILD_SOURCE=${child_source}"
  "-DCHILD_BINARY=${child}" "-DGKLIB_SOURCE_DIR=${GKLIB_SOURCE_DIR}"
  "-DGKLIB_PACKAGE_DIR=${GKLIB_PACKAGE_DIR}"
  "-DGKLIB_EXPECTED_ARCHIVE=${GKLIB_EXPECTED_ARCHIVE}"
  "-DTEST_INITIAL_CACHE=${TEST_INITIAL_CACHE}" "-DTEST_CONFIG=${TEST_CONFIG}"
  "-DIDXTYPEWIDTH=${IDXTYPEWIDTH}" "-DREALTYPEWIDTH=${REALTYPEWIDTH}")
foreach(field INSTANCE PLATFORM TOOLSET)
  if(NOT "${GENERATOR_${field}}" STREQUAL "")
    list(APPEND command "-DCMAKE_GENERATOR_${field}=${GENERATOR_${field}}")
  endif()
endforeach()
run_recorded(parent ${command})
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Fault cache parent failed:\n${output}\n${error}")
endif()
run_recorded(registration "${CMAKE_CTEST_COMMAND}" --test-dir "${parent}"
  -C "${TEST_CONFIG}" --show-only=json-v1)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Fault cache child registration failed: ${output}${error}")
endif()
file(WRITE "${WORK_DIR}/registration-payload.json" "${output}")
run_recorded(configuration "${CMAKE_CTEST_COMMAND}" --test-dir "${parent}"
  -C "${TEST_CONFIG}" --output-on-failure -V --output-junit "${WORK_DIR}/configuration.xml")
file(READ "${parent}/CMakeCache.txt" parent_cache)
if(NOT parent_cache MATCHES "METIS_IPO:STRING=ON" OR
    NOT parent_cache MATCHES "GKLIB_IPO:STRING=ON")
  message(FATAL_ERROR "The structural parent IPO control was changed")
endif()
file(READ "${child}/CMakeCache.txt" cache)
string(REPLACE "\r\n" "\n" cache "${cache}")
foreach(option IN ITEMS METIS_SANITIZERS GKLIB_SANITIZERS)
  string(REGEX MATCH "(^|\n)${option}:[^=]*=([^\n]*)" entry "${cache}")
  if(NOT entry OR NOT "${CMAKE_MATCH_2}" STREQUAL "${value}")
    message(FATAL_ERROR "Fault policy was not preserved: ${option}: ${entry}")
  endif()
endforeach()
foreach(option IN ITEMS METIS_IPO GKLIB_IPO GKLIB_USE_GKRAND GKLIB_NO_X86)
  string(REGEX MATCH "(^|\n)${option}:[^=]*=([^\n]*)" entry "${cache}")
  if(NOT entry OR NOT "${CMAKE_MATCH_2}" STREQUAL "OFF")
    message(FATAL_ERROR "Fault policy OFF override was lost: ${option}")
  endif()
endforeach()
if(NOT "${result}" STREQUAL "0")
  if(CASE STREQUAL "multiple" AND TEST_MSVC_ABI AND
      "${output}${error}" MATCHES "does not support|supports only|do not support|Requested sanitizer is unavailable")
    file(WRITE "${WORK_DIR}/runtime-status.json"
      "{\"transport\":\"PASS\",\"combined_runtime\":\"UNAVAILABLE\",\"reason\":\"selected Windows toolchain rejected the complete request\"}\n")
    message(STATUS "FAULT_POLICY_TRANSPORT_PASS; COMBINED_RUNTIME_UNAVAILABLE")
    return()
  endif()
  message(FATAL_ERROR "Fault policy child failed:\n${output}\n${error}")
endif()
if(CASE STREQUAL "literal")
  file(READ "${child}/received.txt" received)
  if(NOT "${received}" STREQUAL "${value}" OR NOT cache MATCHES "GKLIB_DEBUG:STRING=\n")
    message(FATAL_ERROR "Literal values, including empty data, changed during cache loading")
  endif()
  message(STATUS "FAULT_LITERAL_DATA_ROUNDTRIP_PASS")
  return()
endif()
set(targets metis_api_test)
set(pattern "^metis\\.api$")
if(NOT CASE STREQUAL "empty")
  list(APPEND targets metis_asan_fixture_positive)
  set(pattern "^metis\\.(api|asan-fixture-positive)$")
endif()
if(GKLIB_PACKAGE_DIR)
  fault_cache_api_target(api_target api_executable api_index api_target_file)
  if(EXISTS "${api_executable}")
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISMATCH: consumer exists before its fresh build")
  endif()
  file(READ "${child}/tests/api-gklib-${TEST_CONFIG}.txt" selected_archive)
  file(READ "${child}/tests/api-gklib-link-${TEST_CONFIG}.txt" link_archive)
  file(REAL_PATH "${selected_archive}" selected_archive)
  file(REAL_PATH "${link_archive}" link_archive)
  file(REAL_PATH "${GKLIB_EXPECTED_ARCHIVE}" expected_archive)
  file(SHA256 "${selected_archive}" selected_before)
  file(SHA256 "${link_archive}" link_before)
endif()
run_recorded(build "${CMAKE_COMMAND}" --build "${child}"
  --config "${TEST_CONFIG}" --target ${targets} --parallel 2 --verbose)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Fault policy child build failed:\n${output}\n${error}")
endif()
if(GKLIB_PACKAGE_DIR)
  file(SHA256 "${api_executable}" api_before)
endif()
if(TEST_CROSSCOMPILING AND NOT TEST_EMULATOR)
  message("METIS_RUNTIME_SKIPPED: no cross-compiling emulator")
  return()
endif()
run_recorded(runtime-registration "${CMAKE_CTEST_COMMAND}" --test-dir "${child}"
  -C "${TEST_CONFIG}" -R "${pattern}" --show-only=json-v1)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Fault policy runtime registration failed: ${output}${error}")
endif()
fault_cache_runtime_programs(runtime_programs "${output}")
fault_cache_write_runtime_identity(pre "${runtime_programs}")
if(NOT runtime_identity_ok)
  message(FATAL_ERROR "FAULT_RUNTIME_IDENTITY: selected program unavailable before runtime")
endif()
run_recorded(runtime "${CMAKE_CTEST_COMMAND}" --test-dir "${child}"
  -C "${TEST_CONFIG}" -R "${pattern}" --output-on-failure -V
  --output-junit "${WORK_DIR}/runtime.xml")
fault_cache_write_runtime_identity(post "${runtime_programs}")
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Fault policy child runtime failed:\n${output}\n${error}")
endif()
if(NOT runtime_identity_ok)
  message(FATAL_ERROR "FAULT_RUNTIME_IDENTITY: selected program changed or unavailable after runtime")
endif()
if(GKLIB_PACKAGE_DIR)
  file(SHA256 "${GKLIB_EXPECTED_ARCHIVE}" archive_after)
  file(SHA256 "${selected_archive}" selected_after)
  file(SHA256 "${link_archive}" link_after)
  file(SHA256 "${api_executable}" api_after)
  string(JSON count ERROR_VARIABLE error LENGTH "${api_target}" link commandFragments)
  if(error OR count EQUAL 0)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: consumer link.commandFragments")
  endif()
  set(link_found false)
  set(selected_key "${selected_archive}")
  set(expected_key "${expected_archive}")
  set(link_key "${link_archive}")
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${selected_key}" selected_key)
    string(TOLOWER "${expected_key}" expected_key)
    string(TOLOWER "${link_key}" link_key)
  endif()
  # Codemodel libraries are semantic link inputs even when the native build
  # uses response files. Decode native quoting; unresolved indirection is not
  # evidence of an archive. Never search unrelated rules or path substrings.
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON role GET "${api_target}" link commandFragments ${i} role)
    if(role STREQUAL "libraries")
      string(JSON fragment GET "${api_target}" link commandFragments ${i} fragment)
      separate_arguments(arguments NATIVE_COMMAND "${fragment}")
      foreach(argument IN LISTS arguments)
        if(IS_ABSOLUTE "${argument}")
          file(REAL_PATH "${argument}" path)
          if(CMAKE_HOST_WIN32)
            string(TOLOWER "${path}" path)
          endif()
          if(path STREQUAL link_key)
            set(link_found true)
          endif()
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(field IN ITEMS expected_archive selected_archive link_archive api_executable
      api_index api_target_file TEST_CONFIG GENERATOR)
    fault_cache_json_string(${field}_json "${${field}}")
  endforeach()
  file(WRITE "${WORK_DIR}/system-archive.json"
    "{\"expected_archive\":${expected_archive_json},\"selected_archive\":${selected_archive_json},\"link_archive\":${link_archive_json},\"before_sha256\":\"${archive_before}\",\"after_sha256\":\"${archive_after}\",\"selected_before_sha256\":\"${selected_before}\",\"selected_after_sha256\":\"${selected_after}\",\"link_before_sha256\":\"${link_before}\",\"link_after_sha256\":\"${link_after}\",\"api_executable\":${api_executable_json},\"api_before_sha256\":\"${api_before}\",\"api_after_sha256\":\"${api_after}\",\"file_api_index\":${api_index_json},\"file_api_target\":${api_target_file_json},\"configuration\":${TEST_CONFIG_json},\"generator\":${GENERATOR_json},\"final_link_reference_found\":${link_found},\"fresh_build\":true,\"api_runtime\":\"PASS\"}\n")
  if(NOT selected_key STREQUAL expected_key)
    message(FATAL_ERROR "SYSTEM_SELECTED_ARCHIVE_MISMATCH: expected ${expected_archive}; selected ${selected_archive}")
  endif()
  if(NOT link_found)
    message(FATAL_ERROR "SYSTEM_FINAL_LINK_ARCHIVE_MISMATCH: no exact archive token in consumer link fragments")
  endif()
  if(NOT archive_before STREQUAL archive_after OR
      NOT selected_before STREQUAL selected_after OR NOT link_before STREQUAL link_after)
    message(FATAL_ERROR "SYSTEM_ARCHIVE_CHANGED: installed artifacts changed during child build/runtime")
  endif()
  if(NOT api_before STREQUAL api_after)
    message(FATAL_ERROR "SYSTEM_API_BINARY_CHANGED: executable changed during runtime")
  endif()
  message(STATUS "SYSTEM_ARCHIVE_LINK_CONFIRMED: ${link_archive}")
endif()
file(WRITE "${WORK_DIR}/runtime-status.json"
  "{\"transport\":\"PASS\",\"api_runtime\":\"PASS\",\"wrapping_injection\":\"NOT_RUN\"}\n")
message(STATUS "FAULT_POLICY_AND_API_RUNTIME_PASS; wrapping injection NOT_RUN")
