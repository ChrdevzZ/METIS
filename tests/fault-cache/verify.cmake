# Every child command retains its arguments and raw output, including an
# expected unsupported-policy rejection. Payload values travel in cache files.
function(run_recorded name)
  string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
  set(log "${WORK_DIR}/${name}")
  file(WRITE "${log}.stdout.log" "${output}")
  file(WRITE "${log}.stderr.log" "${error}")
  file(SHA256 "${log}.stdout.log" stdout_hash)
  file(SHA256 "${log}.stderr.log" stderr_hash)
  set(args "")
  set(separator "")
  math(EXPR last "${ARGC} - 1")
  foreach(index RANGE 1 ${last})
    set(value "${ARGV${index}}")
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    string(APPEND args "${separator}\"${value}\"")
    set(separator ",")
  endforeach()
  string(REPLACE "\\" "\\\\" cwd "${CMAKE_CURRENT_BINARY_DIR}")
  file(WRITE "${log}.json"
    "{\"argv\":[${args}],\"cwd\":\"${cwd}\",\"start_utc\":\"${start}\",\"end_utc\":\"${end}\",\"exit\":\"${result}\",\"stdout_sha256\":\"${stdout_hash}\",\"stderr_sha256\":\"${stderr_hash}\",\"environment\":\"inherited unchanged from recorded parent CTest\"}\n")
  set(result "${result}" PARENT_SCOPE)
  set(output "${output}" PARENT_SCOPE)
  set(error "${error}" PARENT_SCOPE)
endfunction()


# Resolve this client's reply and the requested configuration/consumer exactly.
# Generated link fragments require a fresh successful build and API run below.
function(fault_cache_api_target output_target output_executable output_index output_file)
  set(reply "${child}/.cmake/api/v1/reply")
  file(GLOB indexes "${reply}/index-*.json")
  if(NOT indexes)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: no file API reply index")
  endif()
  list(SORT indexes ORDER DESCENDING)
  list(GET indexes 0 index)
  file(READ "${index}" data)
  string(JSON model ERROR_VARIABLE error GET "${data}"
    reply client-metis-fault-cache codemodel-v2 jsonFile)
  if(error)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: this client's codemodel reply: ${error}")
  endif()
  string(JSON generator GET "${data}" cmake generator name)
  if(NOT generator STREQUAL GENERATOR)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISMATCH: child generator ${generator}")
  endif()
  file(READ "${reply}/${model}" data)
  string(JSON count LENGTH "${data}" configurations)
  set(matches 0)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON name GET "${data}" configurations ${i} name)
      if(name STREQUAL TEST_CONFIG)
        string(JSON configuration GET "${data}" configurations ${i})
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
  endif()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: configuration '${TEST_CONFIG}' is not unique")
  endif()
  string(JSON count LENGTH "${configuration}" targets)
  set(matches 0)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON name GET "${configuration}" targets ${i} name)
      if(name STREQUAL "metis_api_test")
        string(JSON target_file GET "${configuration}" targets ${i} jsonFile)
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
  endif()
  if(NOT matches EQUAL 1)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: metis_api_test is not unique")
  endif()
  file(READ "${reply}/${target_file}" target)
  string(JSON type GET "${target}" type)
  string(JSON name GET "${target}" nameOnDisk)
  string(JSON count LENGTH "${target}" artifacts)
  set(matches 0)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON path GET "${target}" artifacts ${i} path)
      get_filename_component(filename "${path}" NAME)
      if(filename STREQUAL name)
        cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${child}" NORMALIZE
          OUTPUT_VARIABLE executable)
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
  endif()
  if(NOT type STREQUAL "EXECUTABLE" OR NOT matches EQUAL 1)
    message(FATAL_ERROR "SYSTEM_LINK_EVIDENCE_MISSING: consumer executable artifact")
  endif()
  set(${output_target} "${target}" PARENT_SCOPE)
  set(${output_executable} "${executable}" PARENT_SCOPE)
  set(${output_index} "${index}" PARENT_SCOPE)
  set(${output_file} "${reply}/${target_file}" PARENT_SCOPE)
endfunction()


function(fault_cache_json_string output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()


# Observe only this fixture's selected programs, using their wrapper arguments.
# The CMake command that launches a wrapper is not the executable under test.
function(fault_cache_runtime_programs output registration)
  string(JSON count LENGTH "${registration}" tests)
  list(LENGTH targets expected)
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "FAULT_RUNTIME_IDENTITY: unexpected runtime selection count")
  endif()
  set(programs "[]")
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON test GET "${registration}" tests ${i} name)
    if(test STREQUAL "metis.api")
      set(argument TEST_EXECUTABLE)
    elseif(test STREQUAL "metis.asan-fixture-positive")
      set(argument PROGRAM)
    else()
      message(FATAL_ERROR "FAULT_RUNTIME_IDENTITY: unexpected selected test ${test}")
    endif()
    string(JSON args LENGTH "${registration}" tests ${i} command)
    math(EXPR end "${args} - 1")
    set(matches 0)
    foreach(j RANGE ${end})
      string(JSON value GET "${registration}" tests ${i} command ${j})
      if(value MATCHES "^-D${argument}=(.*)$")
        set(program "${CMAKE_MATCH_1}")
        math(EXPR matches "${matches} + 1")
      endif()
    endforeach()
    if(NOT matches EQUAL 1 OR NOT IS_ABSOLUTE "${program}")
      message(FATAL_ERROR "FAULT_RUNTIME_IDENTITY: selected program is not one absolute wrapper argument")
    endif()
    fault_cache_json_string(test_json "${test}")
    fault_cache_json_string(argument_json "${argument}")
    fault_cache_json_string(program_json "${program}")
    set(entry "{}")
    string(JSON entry SET "${entry}" test "${test_json}")
    string(JSON entry SET "${entry}" argument "${argument_json}")
    string(JSON entry SET "${entry}" registered_path "${program_json}")
    string(JSON programs SET "${programs}" ${i} "${entry}")
  endforeach()
  set(${output} "${programs}" PARENT_SCOPE)
endfunction()


# Persist pre before launch and post before reporting a runtime failure. Hash
# failures remain observable without replacing the original runtime result.
function(fault_cache_write_runtime_identity phase programs)
  string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
  set(runtime_result "${result}")
  set(all_available true)
  set(all_stable true)
  if(phase STREQUAL "post")
    file(READ "${WORK_DIR}/runtime-pre.json" pre)
    file(SHA256 "${WORK_DIR}/runtime-pre.json" pre_hash)
  endif()
  string(JSON count LENGTH "${programs}")
  math(EXPR last "${count} - 1")
  foreach(i RANGE ${last})
    string(JSON entry GET "${programs}" ${i})
    string(JSON program GET "${entry}" registered_path)
    file(REAL_PATH "${program}" path)
    fault_cache_json_string(path_json "${path}")
    string(JSON entry SET "${entry}" path "${path_json}")
    run_recorded("runtime-${phase}-${i}-hash" "${CMAKE_COMMAND}" -E sha256sum "${path}")
    set(available false)
    if("${result}" STREQUAL "0" AND output MATCHES "^([0-9a-fA-F]+)[ \t]")
      set(hash "${CMAKE_MATCH_1}")
      string(LENGTH "${hash}" length)
      if(length EQUAL 64 AND EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(SIZE "${path}" bytes)
        set(available true)
      endif()
    endif()
    string(JSON entry SET "${entry}" available ${available})
    if(available)
      string(JSON entry SET "${entry}" bytes ${bytes})
      string(JSON entry SET "${entry}" sha256 "\"${hash}\"")
    else()
      set(all_available false)
      string(JSON entry SET "${entry}" bytes null)
      string(JSON entry SET "${entry}" sha256 null)
      string(JSON entry SET "${entry}" reason "\"selected executable unavailable or hash command failed\"")
    endif()
    if(phase STREQUAL "post")
      string(JSON before GET "${pre}" programs ${i})
      string(JSON before_path GET "${before}" path)
      string(JSON before_bytes GET "${before}" bytes)
      string(JSON before_hash GET "${before}" sha256)
      set(stable false)
      if(available AND path STREQUAL before_path AND
          bytes STREQUAL before_bytes AND hash STREQUAL before_hash)
        set(stable true)
      else()
        set(all_stable false)
      endif()
      string(JSON entry SET "${entry}" stable ${stable})
    endif()
    string(JSON programs SET "${programs}" ${i} "${entry}")
  endforeach()
  string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(SHA256 "${WORK_DIR}/runtime-registration.stdout.log" registration_hash)
  set(record "{\"schema_version\":1}")
  string(JSON record SET "${record}" phase "\"${phase}\"")
  string(JSON record SET "${record}" collection_start_utc "\"${start}\"")
  string(JSON record SET "${record}" collection_end_utc "\"${end}\"")
  string(JSON record SET "${record}" registration_sha256 "\"${registration_hash}\"")
  string(JSON record SET "${record}" all_available ${all_available})
  string(JSON record SET "${record}" programs "${programs}")
  if(phase STREQUAL "post")
    fault_cache_json_string(result_json "${runtime_result}")
    string(JSON record SET "${record}" runtime_result "${result_json}")
    string(JSON record SET "${record}" pre_record_sha256 "\"${pre_hash}\"")
    string(JSON record SET "${record}" all_stable ${all_stable})
  endif()
  file(WRITE "${WORK_DIR}/runtime-${phase}.json" "${record}\n")
  if(phase STREQUAL "post")
    set(runtime_identity_ok ${all_stable} PARENT_SCOPE)
  else()
    set(runtime_identity_ok ${all_available} PARENT_SCOPE)
  endif()
endfunction()


